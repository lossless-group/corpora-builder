# The ledger's derived output — regenerated on every pytest run, never committed.
# Committing it would let a stale file answer "is the spec green?" after the
# code moved on, which is the exact drift the ledger exists to prevent.
.spec-results.json

# context-vigilance: scratch and out-of-band material is gitignored by convention
context-v/extra/

# Local corpus mirrors — reconstituted from R2 via rclone, never source of truth
.corpus-cache/
